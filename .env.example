# Copy to .env and fill in. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Real environment variables override these, so CI can inject secrets instead.

# Required for the agent, CLI, evals and Slack bot.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Required only for the Slack bot (python -m src.slack.bot).
#   xoxb- : OAuth & Permissions -> Bot User OAuth Token
#   xapp- : Basic Information -> App-Level Tokens (scope: connections:write)
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_APP_TOKEN=your_slack_app_token

# Optional. Defaults to SQLite at ./blotter.db
# DB_URL=postgresql+psycopg2://user:password@localhost/blotter

# Optional. Exports every run to Langfuse alongside the local trace JSON.
# Leave unset for no export. LANGFUSE_BASE_URL defaults to Langfuse Cloud (EU);
# set it for self-hosted.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
